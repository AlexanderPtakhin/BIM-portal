# ─────────────────────────────────────────────
# BIM Portal — Environment Variables
# ─────────────────────────────────────────────

# ── Database (Supabase) ───────────────────────
# Supabase Project URL (из Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Service Role Key (из Settings > API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Anon Key (из Settings > API)  
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Database URL для Prisma (из Settings > Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ── Auth (Clerk) ──────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# URL для редиректов после auth
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Payments (ЮKassa) ─────────────────────────
YOUKASSA_SHOP_ID=your-shop-id
YOUKASSA_SECRET_KEY=your-secret-key

# ── Notifications ────────────────────────────
RESEND_API_KEY=re_your-resend-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# ── Chat (Stream) ─────────────────────────────
NEXT_PUBLIC_STREAM_API_KEY=your-stream-api-key
STREAM_SECRET=your-stream-secret

# ── Application ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
