# ─────────────────────────────────────────────
# BIM Portal — Environment Variables
# Скопировать в .env.local и заполнить значения
# Получить dev-значения: npx vercel env pull .env.local
# ─────────────────────────────────────────────

# ── Database (Supabase) ───────────────────────
# Pooler URL — для обычных запросов из приложения
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct URL — для Prisma Migrate и db push
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Auth (Clerk) ──────────────────────────────
# Найти в Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Найти в Clerk Dashboard → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# URL для редиректов после auth
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Payments (ЮKassa) ─────────────────────────
# Найти в личном кабинете ЮKassa → Настройки → Данные магазина
YOUKASSA_SHOP_ID=
YOUKASSA_SECRET_KEY=

# URL куда ЮKassa вернёт пользователя после оплаты
NEXT_PUBLIC_YOUKASSA_RETURN_URL=http://localhost:3000/billing/success

# ── Chat (Stream) ─────────────────────────────
# Найти в Stream Dashboard → App → API Credentials
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_SECRET=

# ── Email (Resend) ────────────────────────────
# Найти в Resend Dashboard → API Keys
RESEND_API_KEY=re_...

# Email отправителя (должен быть верифицирован в Resend)
EMAIL_FROM=noreply@bim-portal.ru

# ── Telegram Bot ──────────────────────────────
# Получить через @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# Секрет для верификации webhook-запросов от Telegram
# Произвольная строка, задаётся при регистрации webhook
TELEGRAM_WEBHOOK_SECRET=

# ── Storage (Cloudflare R2) ───────────────────
# Найти в Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bim-portal-uploads

# Публичный URL бакета (настраивается в R2 → Bucket → Public access)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Application ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NODE_ENV устанавливается автоматически Next.js
# development / production / test
