generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ClientProfile {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String        @unique @db.Uuid
  company_name        String?
  company_description String?
  company_size        String?
  industry            String?
  website             String?
  phone               String?
  country             String?
  city                String?
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @default(now()) @db.Timestamptz(6)
  users               users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invitations         invitations[]
  jobs                Job[]

  @@map("client_profiles")
}

model Job {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id              String        @db.Uuid
  title                  String
  description            String
  category               String
  skills                 String[]
  budget_type            String
  budget_min             Decimal?      @db.Decimal(10, 2)
  budget_max             Decimal?      @db.Decimal(10, 2)
  duration_days          Int?
  deadline               DateTime?     @db.Timestamptz(6)
  location_type          String
  location               String?
  status                 job_status    @default(DRAFT)
  publication_payment_id String?
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @db.Timestamptz(6)
  invitations            invitations[]
  client_profiles        ClientProfile @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  proposals              proposals[]
  reports                reports[]

  @@index([category], map: "idx_jobs_category")
  @@index([client_id], map: "idx_jobs_client_id")
  @@index([created_at(sort: Desc)], map: "idx_jobs_created_at")
  @@index([status], map: "idx_jobs_status")
  @@map("jobs")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contracts {
  id                                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposal_id                          String?         @unique @db.Uuid
  client_id                            String          @db.Uuid
  freelancer_id                        String          @db.Uuid
  amount                               Decimal         @db.Decimal(10, 2)
  description                          String?
  status                               contract_status @default(DRAFT)
  started_at                           DateTime?       @db.Timestamptz(6)
  completed_at                         DateTime?       @db.Timestamptz(6)
  created_at                           DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime        @default(now()) @db.Timestamptz(6)
  invitation_id                        String?         @unique @db.Uuid
  users_contracts_client_idTousers     users           @relation("contracts_client_idTousers", fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_contracts_freelancer_idTousers users           @relation("contracts_freelancer_idTousers", fields: [freelancer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  proposals                            proposals?      @relation(fields: [proposal_id], references: [id], onUpdate: NoAction)
  invitations                          invitations?    @relation(fields: [invitation_id], references: [id], onUpdate: NoAction, map: "fk_invitation")
  reviews                              reviews[]

  @@index([client_id], map: "idx_contracts_client_id")
  @@index([freelancer_id], map: "idx_contracts_freelancer_id")
  @@index([status], map: "idx_contracts_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model education {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancer_id       String              @db.Uuid
  institution         String
  degree              String
  field               String
  start_date          DateTime            @db.Timestamptz(6)
  end_date            DateTime?           @db.Timestamptz(6)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  freelancer_profiles freelancer_profiles @relation(fields: [freelancer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model experience {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancer_id       String              @db.Uuid
  company             String
  position            String
  description         String?
  start_date          DateTime            @db.Timestamptz(6)
  end_date            DateTime?           @db.Timestamptz(6)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  freelancer_profiles freelancer_profiles @relation(fields: [freelancer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model freelancer_profiles {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String                   @unique @db.Uuid
  title               String?
  bio                 String?
  location            String?
  website             String?
  hourly_rate         Decimal?                 @db.Decimal(10, 2)
  completed_contracts Int                      @default(0)
  rating              Decimal                  @default(0.0) @db.Decimal(3, 2)
  review_count        Int                      @default(0)
  level               freelancer_level         @default(BEGINNER)
  is_verified         Boolean                  @default(false)
  skills              String[]
  status              String                   @default("DRAFT")
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                 @default(now()) @db.Timestamptz(6)
  search_vector       Unsupported("tsvector")?
  education           education[]
  experience          experience[]
  users               users                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  portfolio_items     portfolio_items[]
  proposals           proposals[]

  @@index([search_vector], map: "idx_freelancer_profiles_search", type: Gin)
}

model invitations {
  id                                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiver_id                          String         @db.Uuid
  sender_id                            String         @db.Uuid
  client_id                            String?        @db.Uuid
  job_id                               String?        @db.Uuid
  message                              String
  status                               String         @default("PENDING")
  expires_at                           DateTime       @default(dbgenerated("(now() + '7 days'::interval)")) @db.Timestamptz(6)
  created_at                           DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime       @default(now()) @db.Timestamptz(6)
  contracts                            contracts?
  client_profiles                      ClientProfile? @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  jobs                                 Job?           @relation(fields: [job_id], references: [id], onUpdate: NoAction)
  users_invitations_receiver_idTousers users          @relation("invitations_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_invitations_sender_idTousers   users          @relation("invitations_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([receiver_id, job_id])
  @@index([expires_at], map: "idx_invitations_expires_at")
  @@index([receiver_id], map: "idx_invitations_receiver")
  @@index([sender_id], map: "idx_invitations_sender")
  @@index([status], map: "idx_invitations_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String
  title      String
  body       String
  link       String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_notifications_created_at")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([user_id], map: "idx_notifications_user_id")
}

model payments {
  id                                                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  youkassa_payment_id                                   String?         @unique
  youkassa_sub_id                                       String?
  subscription_id                                       String?         @db.Uuid
  purpose                                               String
  amount                                                Decimal         @db.Decimal(10, 2)
  status                                                String          @default("PENDING")
  refund_note                                           String?
  created_at                                            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                                            DateTime        @default(now()) @db.Timestamptz(6)
  subscriptions_payments_subscription_idTosubscriptions subscriptions?  @relation("payments_subscription_idTosubscriptions", fields: [subscription_id], references: [id], onUpdate: NoAction)
  subscriptions_subscriptions_payment_idTopayments      subscriptions[] @relation("subscriptions_payment_idTopayments")

  @@index([status], map: "idx_payments_status")
  @@index([subscription_id], map: "idx_payments_subscription")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model portfolio_items {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancer_id       String              @db.Uuid
  title               String
  description         String
  images              String[]
  technologies        String[]
  project_url         String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  freelancer_profiles freelancer_profiles @relation(fields: [freelancer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model proposals {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id              String              @db.Uuid
  freelancer_id       String              @db.Uuid
  cover_letter        String
  price               Decimal             @db.Decimal(10, 2)
  duration_days       Int
  status              proposal_status     @default(PENDING)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  contracts           contracts?
  freelancer_profiles freelancer_profiles @relation(fields: [freelancer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs                Job                 @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([job_id, freelancer_id])
  @@index([freelancer_id], map: "idx_proposals_freelancer_id")
  @@index([job_id], map: "idx_proposals_job_id")
  @@index([status], map: "idx_proposals_status")
}

model reports {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_id   String    @db.Uuid
  user_id     String?   @db.Uuid
  job_id      String?   @db.Uuid
  reason      String
  description String
  status      String    @default("OPEN")
  resolution  String?
  resolved_by String?   @db.Uuid
  resolved_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  jobs        Job?      @relation(fields: [job_id], references: [id], onUpdate: NoAction)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([job_id], map: "idx_reports_job")
  @@index([status], map: "idx_reports_status")
  @@index([target_id], map: "idx_reports_target")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reviews {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contract_id String      @db.Uuid
  author_id   String      @db.Uuid
  rating      Int
  comment     String?
  type        review_type
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  users       users       @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contracts   contracts   @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([contract_id, author_id])
  @@index([author_id], map: "idx_reviews_author_id")
  @@index([contract_id], map: "idx_reviews_contract_id")
}

model search_configs {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String                   @unique @db.Uuid
  search_vector Unsupported("tsvector")?
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                 @default(now()) @db.Timestamptz(6)
  users         users                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([search_vector], map: "idx_search_configs_search", type: Gin)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subscriptions {
  id                                               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                          String            @unique @db.Uuid
  plan                                             subscription_plan @default(FREE)
  is_active                                        Boolean           @default(true)
  auto_renew                                       Boolean           @default(false)
  job_posts_left                                   Int               @default(1)
  starts_at                                        DateTime          @default(now()) @db.Timestamptz(6)
  expires_at                                       DateTime?         @db.Timestamptz(6)
  cancelled_at                                     DateTime?         @db.Timestamptz(6)
  youkassa_sub_id                                  String?
  created_at                                       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime          @default(now()) @db.Timestamptz(6)
  payment_id                                       String?           @db.Uuid
  payments_payments_subscription_idTosubscriptions payments[]        @relation("payments_subscription_idTosubscriptions")
  payments_subscriptions_payment_idTopayments      payments?         @relation("subscriptions_payment_idTopayments", fields: [payment_id], references: [id], onUpdate: NoAction, map: "fk_payment")
  users                                            users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_documents {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  document_type String
  file_url      String
  file_name     String
  file_size     Int
  status        String    @default("PENDING")
  review_note   String?
  reviewed_by   String?   @db.Uuid
  reviewed_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_user_documents_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                                         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerk_id                                   String               @unique
  email                                      String
  name                                       String
  role                                       user_role            @default(FREELANCER)
  account_type                               account_type         @default(INDIVIDUAL)
  is_blocked                                 Boolean              @default(false)
  created_at                                 DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime             @default(now()) @db.Timestamptz(6)
  client_profiles                            ClientProfile?
  contracts_contracts_client_idTousers       contracts[]          @relation("contracts_client_idTousers")
  contracts_contracts_freelancer_idTousers   contracts[]          @relation("contracts_freelancer_idTousers")
  freelancer_profiles                        freelancer_profiles?
  invitations_invitations_receiver_idTousers invitations[]        @relation("invitations_receiver_idTousers")
  invitations_invitations_sender_idTousers   invitations[]        @relation("invitations_sender_idTousers")
  notifications                              notifications[]
  reports                                    reports[]
  reviews                                    reviews[]
  search_configs                             search_configs?
  subscriptions                              subscriptions?
  user_documents                             user_documents[]

  @@index([clerk_id], map: "idx_users_clerk_id")
  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
}

enum account_type {
  INDIVIDUAL
  COMPANY
}

enum contract_status {
  DRAFT
  ACTIVE
  COMPLETED
  DISPUTED
  CANCELLED
}

enum freelancer_level {
  BEGINNER
  PRO
  EXPERT
}

enum job_status {
  DRAFT
  PENDING
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum proposal_status {
  PENDING
  ACCEPTED
  REJECTED
}

enum review_type {
  CLIENT_TO_FREELANCER
  FREELANCER_TO_CLIENT
}

enum subscription_plan {
  FREE
  PRO
  PREMIUM
}

enum user_role {
  FREELANCER
  CLIENT
  ADMIN
}
